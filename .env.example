# Bluesky — create an app password at https://bsky.app/settings/app-passwords
# (or in the PDS admin UI / pdsadmin if you're self-hosted)
BLUESKY_HANDLE=you.bsky.social
BLUESKY_APP_PASSWORD=
# Optional: log in by DID instead of handle. A DID never changes, so login
# survives handle rotation (a changing handle otherwise causes "Invalid
# identifier or password"). Overrides BLUESKY_HANDLE for login when set.
# Resolve yours: curl "https://bsky.social/xrpc/com.atproto.identity.resolveHandle?handle=you.bsky.social"
# BLUESKY_IDENTIFIER=did:plc:...
# Self-hosted PDS: set this to your PDS URL (e.g. https://pds.example.com).
# Leave unset to use bsky.social.
# BLUESKY_PDS_URL=

# Fedi (Mastodon API compatible) — run ./setup-fedi-auth.sh to set these up
FEDI_INSTANCE_URL=https://mastodon.social
FEDI_ACCESS_TOKEN=
FEDI_CLIENT_ID=
FEDI_CLIENT_SECRET=
FEDI_CHAR_LIMIT=3000

# Optional: Anthropic-compatible API for AI alt text generation
# Set ANTHROPIC_BASE_URL to point at a proxy (e.g. https://dario.example) — leave unset for api.anthropic.com
# ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
# ALT_TEXT_MODEL=claude-sonnet-4-6

# Server
PORT=3000
